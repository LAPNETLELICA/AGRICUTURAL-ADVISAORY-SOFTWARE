APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://agriadviser:agriadviser@localhost:5432/agriadviser
POSTGRES_DB=agriadviser
POSTGRES_USER=agriadviser
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
KNOWLEDGE_PATH=BASE_CONNAISSANCES_AGRICOLES
SMS_MAX_LENGTH=160
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://127.0.0.1:8000,https://lapnetlelica.github.io

# V1 security and provider extension points
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_STORE_PATH=runtime/users.json
AUTH_TOKEN_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
WEATHER_PROVIDER=disabled
TRANSLATION_PROVIDER=passthrough
SPEECH_PROVIDER=disabled
SMS_PROVIDER=simulator

# Tranzak SMS: use simulator until the Tranzak adapter is enabled and tested.
TRANZAK_APP_ID=
TRANZAK_APP_KEY=
TRANZAK_SENDER_ID=
TRANZAK_BASE_URL=https://sandbox.dsapi.tranzak.me
TRANZAK_TIMEOUT_SECONDS=10
PROACTIVE_SMS_ENABLED=false
PROACTIVE_SMS_INTERVAL_SECONDS=3600

# Real-time provider keys: paste real values only in your backend deployment environment, never commit them.
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=your_actual_openweathermap_key_here
GROQ_API_KEY=gsk_your_actual_groq_key_here
FISH_AUDIO_API_KEY=your_actual_fish_audio_key_here
# SPEECH_PROVIDER=fish_audio
# TRANSCRIPTION_PROVIDER=groq

# Controlled image evidence
MEDIA_STORAGE_PATH=runtime/media
MEDIA_MAX_BYTES=10485760
MEDIA_RETENTION_DAYS=180

# Privacy / data retention
TRACE_RETENTION_DAYS=180
HISTORY_RETENTION_DAYS=730
SMS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Production TLS via Caddy (docker compose --profile production up -d)
DOMAIN=api.example.org
TLS_EMAIL=ops@example.org

# PostgreSQL backup worker
BACKUP_RETENTION_DAYS=30
